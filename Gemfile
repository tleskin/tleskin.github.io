source "https://rubygems.org"

# Pins the exact stack GitHub Pages builds with (github-pages v232,
# Jekyll 3.10, Ruby 3.3). Run `bundle install` to generate Gemfile.lock.
gem "github-pages", "~> 232", group: :jekyll_plugins

# Needed for `bundle exec jekyll serve` on Ruby 3.x (local preview only;
# GitHub Pages ignores the Gemfile when it builds).
gem "webrick"
